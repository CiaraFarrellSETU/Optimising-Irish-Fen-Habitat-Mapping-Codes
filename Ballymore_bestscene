// =================================================================
// 1. IMPORT ASSET & PRE-FILTER
// =================================================================
var habitatPolygons = ee.FeatureCollection("projects/ciarafarrell755/assets/Sbog")
  .filter(ee.Filter.notNull(['HCH_MAPPED']));

// =================================================================
// 2. CONVERT STRINGS TO NUMBERS
// =================================================================
var habitatNames = ['FS1', 'FS2', 'FW2/WL2', 'GS4', 'PF1', 'PF3', 'WD4', 'WN6', 'WN7'];
var habitatIDs = [1, 2, 3, 4, 5, 6, 7, 8, 9];

var habitatsMapped = habitatPolygons.map(function(f) {
  var code = ee.String(f.get('HCH_MAPPED'));
  var num = ee.Dictionary({
    'FS1': 1, 'FS2': 2, 'FW2/WL2': 3, 'GS4': 4, 
    'PF1': 5, 'PF3': 6, 'WD4': 7, 'WN6': 8, 'WN7': 9
  }).get(code, 0); 
  return f.set('habitat_num', num);
}).filter(ee.Filter.gt('habitat_num', 0));



// =================================================================
var topo = ee.Image("USGS/SRTMGL1_003");
var elevation = topo.select('elevation').clip(habitatPolygons).rename('Elevation');
var terrain = ee.Terrain.products(elevation);
var slope = terrain.select('slope').rename('Slope');
var aspect = terrain.select('aspect').rename('Aspect');

// =================================================================
// 3. MONTHLY TIME-SERIES STACK (June-Sept 2020) + 8 INDICES
// =================================================================
var collection2025 = ee.ImageCollection("COPERNICUS/S2_SR_HARMONIZED")
  .filterBounds(habitatPolygons)
  .filterDate('2020-06-01', '2020-09-30')
  //.filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE', 30));

var getMonthlyStats = function(month, label) {
  var monthlyMedian = collection2025
    .filter(ee.Filter.calendarRange(month, month, 'month'))
    .median();
    
  var nir = monthlyMedian.select('B8');
  var red = monthlyMedian.select('B4');
  var blue = monthlyMedian.select('B2');
  var green = monthlyMedian.select('B3');

  // Calculate 8 Indices per Month
  var ndvi  = monthlyMedian.normalizedDifference(['B8', 'B4']).rename('NDVI_' + label);
  var rvi   = nir.divide(red).rename('RVI_' + label);
  var savi  = monthlyMedian.expression('((NIR-RED)/(NIR+RED+0.5))*1.5', {'NIR':nir,'RED':red}).rename('SAVI_'+label);
  var evi   = monthlyMedian.expression('2.5*((NIR-RED)/(NIR+6*RED-7.5*BLUE+1))', {'NIR':nir,'RED':red,'BLUE':blue}).rename('EVI_'+label);
  var gndvi = monthlyMedian.normalizedDifference(['B8', 'B3']).rename('GNDVI_'+label);
  var grvi  = monthlyMedian.normalizedDifference(['B3', 'B4']).rename('GRVI_'+label);
  var nrvi  = (rvi.subtract(1)).divide(rvi.add(1)).rename('NRVI_'+label);
  var ndwi  = monthlyMedian.normalizedDifference(['B3', 'B8']).rename('NDWI_'+label);
  
  return monthlyMedian
    .select(['B2', 'B3', 'B4', 'B8'], ['B2_' + label, 'B3_' + label, 'B4_' + label, 'B8_' + label])
    .addBands([ndvi, rvi, savi, evi, gndvi, grvi, nrvi, ndwi]);
};

var june = getMonthlyStats(6, 'Jun');
var july = getMonthlyStats(7, 'Jul');
var aug  = getMonthlyStats(8, 'Aug');
var sept = getMonthlyStats(9, 'Sep');

// Stack all 4 months + 3 Topo bands
var finalImage = ee.Image.cat([june, july, aug, sept, elevation, slope, aspect]).clip(habitatPolygons);
// =================================================================
// 4. INCREASE PIXELS (Sampling at 5m scale)
// =================================================================
var allSamples = finalImage.sampleRegions({
  collection: habitatsMapped,
  properties: ['habitat_num'],
  scale: 5, 
  tileScale: 4
}).randomColumn('random');

var trainingSamples = allSamples.filter(ee.Filter.lt('random', 0.8));
var validationSamples = allSamples.filter(ee.Filter.gte('random', 0.8));

// =================================================================
// 5. TRAIN ROBUST CLASSIFIER
// =================================================================
var classifier = ee.Classifier.smileRandomForest(250).train({
  features: trainingSamples,
  classProperty: 'habitat_num',
  inputProperties: finalImage.bandNames()
});

// =================================================================
// 6. VALIDATE & SMOOTH
// =================================================================
var rawClassified = finalImage.classify(classifier);

var smoothed = rawClassified
  .reproject({crs: 'EPSG:4326', scale: 10})
  .focalMode(1, 'square', 'pixels');

// =================================================================
// 7. DISPLAY LAYERS
// =================================================================
Map.centerObject(habitatPolygons, 15);
var bogPalette = ['#FFA500', '#008000', '#FFC0CB', '#FF0000', '#800080', '#A52A2A', '#D2B48C', '#FFFF00', '#0000FF'];

Map.addLayer(finalImage, {bands: ['B4', 'B3', 'B2'], min: 0, max: 3000}, 'Satellite (True Color)');
Map.addLayer(smoothed, {min: 1, max: 9, palette: bogPalette}, 'Scragh Bog Classified Map');

// =================================================================
// 8. ACCURACY REPORTING (Validation Data - Unseen)
// =================================================================
var validated = validationSamples.classify(classifier);
var errorMatrix = validated.errorMatrix('habitat_num', 'classification');

print('--- VALIDATION ACCURACY (Test Data) ---');
print('Validation Accuracy:', errorMatrix.accuracy());
print('Validation Kappa:', errorMatrix.kappa());

// =================================================================
// 8.5 TRAINING ACCURACY (Internal Check for Overfitting)
// =================================================================
var trainAccuracyMatrix = classifier.confusionMatrix();

print('--- TRAINING ACCURACY (Internal) ---');
print('Training Accuracy:', trainAccuracyMatrix.accuracy());
print('Training Confusion Matrix:', trainAccuracyMatrix);


// =================================================================
// 10. AREA CALCULATION
// =================================================================
var classNames = ee.List(['FS1', 'FS2', 'FW2/WL2', 'GS4', 'PF1', 'PF3', 'WD4', 'WN6', 'WN7']);
var areaImage = ee.Image.pixelArea().addBands(smoothed);

var areas = areaImage.reduceRegion({
  reducer: ee.Reducer.sum().group({
    groupField: 1,
    groupName: 'class',
  }),
  geometry: habitatPolygons.geometry(),
  scale: 10,
  maxPixels: 1e13
});

var stats = ee.List(areas.get('groups'));

var areaResults = stats.map(function(item) {
  var dict = ee.Dictionary(item);
  var classId = ee.Number(dict.get('class')).toInt();
  var areaM2 = ee.Number(dict.get('sum'));
  var areaHa = areaM2.divide(10000);
  var label = classNames.get(classId.subtract(1));
  
  return ee.Feature(null, {
    'Habitat_Code': label,
    'Class_ID': classId,
    'Area_Ha': areaHa
  });
});

var areaFC = ee.FeatureCollection(areaResults);
var totalArea = areaFC.aggregate_sum('Area_Ha');

var finalStats = areaFC.map(function(f) {
  var pct = ee.Number(f.get('Area_Ha')).divide(totalArea).multiply(100);
  return f.set('Percentage', pct);
});

// =================================================================
// 11. VISUALIZATION CHARTS
// =================================================================
print(ui.Chart.feature.byFeature(finalStats, 'Habitat_Code', 'Area_Ha').setChartType('ColumnChart').setOptions({title: 'Area (Ha)'}));
print(ui.Chart.feature.byFeature(finalStats, 'Habitat_Code', 'Percentage').setChartType('PieChart').setOptions({title: 'Composition %', colors: bogPalette}));

print('--- HABITAT PERCENTAGE BREAKDOWN ---');
finalStats.evaluate(function(featureCollection) {
  featureCollection.features.forEach(function(feature) {
    var props = feature.properties;
    print(props.Habitat_Code + ': ' + props.Percentage.toFixed(2) + '% (' + props.Area_Ha.toFixed(2) + ' Ha)');
  });
});
