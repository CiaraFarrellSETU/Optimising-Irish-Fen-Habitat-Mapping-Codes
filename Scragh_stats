//=================================================================
// 1. IMPORT ASSET & PRE-FILTER
// =================================================================
var habitatPolygons = ee.FeatureCollection("projects/ciarafarrell755/assets/Sbog")
  .filter(ee.Filter.notNull(['HCH_MAPPED']));

// =================================================================
// 2. CONVERT STRINGS TO NUMBERS
// =================================================================
var habitatNames = ['FS1', 'FS2', 'FW2/WL2', 'GS4', 'PF1', 'PF3', 'WD4', 'WN6', 'WN7'];
var habitatIDs = [1, 2, 3, 4, 5, 6, 7, 8, 9];

var habitatsMapped = habitatPolygons.map(function(f) {
  var code = ee.String(f.get('HCH_MAPPED'));
  var num = ee.Dictionary({
    'FS1': 1, 'FS2': 2, 'FW2/WL2': 3, 'GS4': 4, 
    'PF1': 5, 'PF3': 6, 'WD4': 7, 'WN6': 8, 'WN7': 9
  }).get(code, 0); 
  return f.set('habitat_num', num);
}).filter(ee.Filter.gt('habitat_num', 0));

// =================================================================
// 3. SELECT IMAGERY + SPECTRAL BANDS (WITH SCALING FIXES)
// =================================================================
var collectionBeforeMedian = ee.ImageCollection("COPERNICUS/S2_SR_HARMONIZED")
  .filterBounds(habitatPolygons)
  .filterDate('2020-01-01', '2020-12-31');

var image = collectionBeforeMedian.median().clip(habitatPolygons);

// Create a cleanly scaled 0-1 reflectance image for explicit expression inputs
var scaledImage = image.select(['B2', 'B3', 'B4', 'B8']).multiply(0.0001);

// --- SPECTRAL INDICES CALCULATION ---

// 1. NDVI (Normalized Difference Vegetation Index)
var ndvi = image.normalizedDifference(['B8', 'B4']).rename('NDVI');

// 2. RVI (Ratio Vegetation Index): NIR / Red
var rvi = image.select('B8').divide(image.select('B4')).rename('RVI');

// 3. GNDVI (Green NDVI): (NIR - Green) / (NIR + Green)
var gndvi = image.normalizedDifference(['B8', 'B3']).rename('GNDVI');

// 4. SAVI (Soil Adjusted Vegetation Index - Fixed Scaling)
var savi = scaledImage.expression(
    '1.5 * ((NIR - RED) / (NIR + RED + 0.5))', {
      'NIR': scaledImage.select('B8'),
      'RED': scaledImage.select('B4')
    }).rename('SAVI').clamp(-1.0, 1.0);

// 5. EVI (Enhanced Vegetation Index - Fixed Scaling & Multipliers)
var evi = scaledImage.expression(
    '2.5 * ((NIR - RED) / (NIR + 6.0 * RED - 7.5 * BLUE + 1.0))', {
      'NIR': scaledImage.select('B8'),
      'RED': scaledImage.select('B4'),
      'BLUE': scaledImage.select('B2')
    }).rename('EVI').clamp(-1.0, 1.0);

// 6. GRVI (Green-Red Vegetation Index): (Green - Red) / (Green + Red)
var grvi = image.normalizedDifference(['B3', 'B4']).rename('GRVI');

// 7. NRVI (Normalized Ratio Vegetation Index): (RVI - 1) / (RVI + 1)
var nrvi = image.expression(
    '(RVI - 1) / (RVI + 1)', {
      'RVI': rvi
    }).rename('NRVI');

// 8. NDWI (Normalized Difference Water Index): (Green - NIR) / (Green + NIR)
var ndwi = image.normalizedDifference(['B3', 'B8']).rename('NDWI');

// --- COMBINE INTO FINAL IMAGE ---
// Keeping B2 and B8 raw to match your existing logic workflow
var finalImage = image.addBands([ndvi, rvi, gndvi, savi, evi, grvi, nrvi, ndwi])
  .select(['B2', 'B3', 'B4', 'B8',
    'NDVI', 'RVI', 'GNDVI', 'SAVI', 'EVI', 'GRVI', 'NRVI', 'NDWI'
  ]);

// =================================================================
// 4. INCREASE PIXELS (Sampling at 5m scale)
// =================================================================
var allSamples = finalImage.sampleRegions({
  collection: habitatsMapped,
  properties: ['habitat_num'],
  scale: 5, 
  tileScale: 4
}).randomColumn('random');

var trainingSamples = allSamples.filter(ee.Filter.lt('random', 0.8));
var validationSamples = allSamples.filter(ee.Filter.gte('random', 0.8));

// =================================================================
// 5. TRAIN ROBUST CLASSIFIER
// =================================================================
var classifier = ee.Classifier.smileRandomForest(250).train({
  features: trainingSamples,
  classProperty: 'habitat_num',
  inputProperties: finalImage.bandNames()
});

