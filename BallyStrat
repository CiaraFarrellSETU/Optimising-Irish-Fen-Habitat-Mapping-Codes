// =================================================================
// 1. IMPORT ASSET & PRE-FILTER
// =================================================================
var habitatPolygons = ee.FeatureCollection("projects/ciarafarrell755/assets/Ballymore")
  .filter(ee.Filter.notNull(['FossittCod']));

// =================================================================
// 2. CONVERT STRINGS TO NUMBERS (Using FossittCod)
// =================================================================
var habitatNames = ['GM1', 'WS1/GS2', 'PB1', 'PF1', 'PF3', 'PF3/GM1', 'PF1/PF3', 'WS1/PB4'];
var habitatIDs = [1, 2, 3, 4, 5, 6, 7, 8];

var habitatDict = ee.Dictionary({
  'GM1': 1, 'WS1/GS2': 2, 'PB1': 3, 'PF1': 4,  
  'PF3': 5, 'PF3/GM1': 6, 'PF1/PF3': 7, 'WS1/PB4': 8
});

var habitatsMapped = habitatPolygons.map(function(f) {
  var code = f.get('FossittCod');  
  var num = ee.Number(habitatDict.get(code, -999));  
  return f.set('habitat_num', num);
}).filter(ee.Filter.gt('habitat_num', 0));

// =================================================================
// 3. SELECT IMAGERY + SPECTRAL INDICES
// =================================================================
 var image = ee.ImageCollection("COPERNICUS/S2_SR_HARMONIZED")
   .filterBounds(habitatPolygons)
   .filterDate('2020-06-01', '2020-09-30') 
   .filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE', 30)) 
   .median() 
   .clip(habitatPolygons);

 var nir   = image.select('B8');
 var red   = image.select('B4');
 var blue  = image.select('B2');
 var green = image.select('B3');

 var ndvi  = image.normalizedDifference(['B8', 'B4']).rename('NDVI');
 var rvi   = nir.divide(red).rename('RVI');
 var savi  = image.expression('((NIR - RED) / (NIR + RED + 0.5)) * 1.5', {'NIR': nir, 'RED': red}).rename('SAVI');
 var evi   = image.expression('2.5 * ((NIR - RED) / (NIR + 6 * RED - 7.5 * BLUE + 1))', {'NIR': nir, 'RED': red, 'BLUE': blue}).rename('EVI');
 var gndvi = image.normalizedDifference(['B8', 'B3']).rename('GNDVI');
 var grvi  = image.normalizedDifference(['B3', 'B4']).rename('GRVI');
 var nrvi  = (rvi.subtract(1)).divide(rvi.add(1)).rename('NRVI');
 var ndwi  = image.normalizedDifference(['B3', 'B8']).rename('NDWI');

 var finalImage = image.select(['B2', 'B3', 'B4', 'B8']) 
   .addBands([ndvi, rvi, savi, evi, gndvi, grvi, nrvi, ndwi]); 

print('Final Stack Layers (Phan et al. Method):', finalImage.bandNames());

// =================================================================
// 4. STRATIFIED SAMPLING (Guarantees N > 0 for all 8 classes)
// =================================================================
var allSamples = finalImage.sampleRegions({
  collection: habitatsMapped,
  properties: ['habitat_num'],
  scale: 5,  
  tileScale: 4
});

var trainingSamples = ee.FeatureCollection([]);
var validationSamples = ee.FeatureCollection([]);

habitatIDs.forEach(function(id) {
  var classSamples = allSamples.filter(ee.Filter.eq('habitat_num', id)).randomColumn('random');
  var classTrain = classSamples.filter(ee.Filter.lt('random', 0.8));
  var classVal = classSamples.filter(ee.Filter.gte('random', 0.8));
  
  trainingSamples = trainingSamples.merge(classTrain);
  validationSamples = validationSamples.merge(classVal);
});

// =================================================================
// 5. TRAIN ROBUST CLASSIFIER
// =================================================================
var classifier = ee.Classifier.smileRandomForest(250).train({
  features: trainingSamples,
  classProperty: 'habitat_num',
  inputProperties: finalImage.bandNames()
});

// =================================================================
// 6. VALIDATE & SMOOTH
// =================================================================
var rawClassified = finalImage.classify(classifier);

var smoothed = rawClassified
  .reproject({crs: 'EPSG:4326', scale: 10})
  .focalMode(1, 'square', 'pixels');

// =================================================================
// 7. DISPLAY LAYERS
// =================================================================
Map.centerObject(habitatPolygons, 15);
var bogPalette = ['#FFA500', '#008000', '#FFC0CB', '#FF0000', '#800080', '#A52A2A', '#D2B48C', '#FFFF00'];

Map.addLayer(image, {bands: ['B4', 'B3', 'B2'], min: 0, max: 3000}, 'Satellite (True Color)');
Map.addLayer(smoothed, {min: 1, max: 8, palette: bogPalette}, 'Ballymore Classified Map');

// =================================================================
// 8. ACCURACY REPORTING & DETAILED PER-CLASS METRICS
// =================================================================
var validated = validationSamples.classify(classifier);
var errorMatrix = validated.errorMatrix('habitat_num', 'classification', habitatIDs);

print('--- FINAL VALIDATION SUMMARY ---');
errorMatrix.accuracy().evaluate(function(val) {
  print('Overall Accuracy: ' + (val * 100).toFixed(2) + '%');
});

errorMatrix.kappa().evaluate(function(val) {
  print('Kappa Coefficient: ' + val.toFixed(4));
});

var cmArray = ee.Array(errorMatrix.array());

print('--- PER-CLASS METRICS BREAKDOWN (N, PA, UA, F1) ---');
cmArray.evaluate(function(matrix) {
  habitatNames.forEach(function(name, i) {
    var rowSum = 0; // Total reference samples (N) for this true class
    var colSum = 0; // Total predicted samples for this class
    var correct = matrix[i][i]; // True positives

    for (var j = 0; j < habitatNames.length; j++) {
      rowSum += matrix[i][j];
      colSum += matrix[j][i];
    }

    var paDec = (rowSum > 0) ? (correct / rowSum) : 0;
    var uaDec = (colSum > 0) ? (correct / colSum) : 0;
    var f1Score = (paDec + uaDec > 0) ? (2 * paDec * uaDec) / (paDec + uaDec) : 0;

    var paStr = (rowSum > 0) ? (paDec * 100).toFixed(2) + '%' : 'N/A';
    var uaStr = (colSum > 0) ? (uaDec * 100).toFixed(2) + '%' : 'N/A';

    print(name + ' [N = ' + rowSum + '] -> Producer\'s: ' + paStr + 
          ' | User\'s: ' + uaStr + 
          ' | F1-Score: ' + f1Score.toFixed(4));
  });
});

// =================================================================
// 8.1 FORMATTED CONFUSION MATRIX TABLE DISPLAY
// =================================================================
print('--- CONFUSION MATRIX TABLE (Actual Rows vs Predicted Columns) ---');
cmArray.evaluate(function(matrix) {
  var header = 'Actual \\ Pred\t' + habitatNames.join('\t');
  print(header);
  matrix.forEach(function(row, i) {
    var rowString = habitatNames[i] + '\t\t' + row.join('\t');
    print(rowString);
  });
});
