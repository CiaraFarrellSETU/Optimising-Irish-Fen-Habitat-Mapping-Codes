  .filterBounds(habitatPolygons)
  .filterDate('2024-01-01', '2024-12-31')
  .filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE', 30));

print('Number of images used:', collectionBeforeMedian.size());




