// 1. IMPORT ASSET & PRE-FILTER
var habitatPolygons = ee.FeatureCollection("projects/ciarafarrell755/assets/Sbog")
  .filter(ee.Filter.notNull(['HCH_MAPPED']));

// 2. CONVERT STRINGS TO NUMBERS
var habitatNames = ['FS1', 'FS2', 'FW2/WL2', 'GS4', 'PF1', 'PF3', 'WD4', 'WN6', 'WN7'];
var habitatIDs = [1, 2, 3, 4, 5, 6, 7, 8, 9];

var habitatsMapped = habitatPolygons.map(function(f) {
  var code = ee.String(f.get('HCH_MAPPED'));
  var num = ee.Dictionary({
    'FS1': 1, 'FS2': 2, 'FW2/WL2': 3, 'GS4': 4, 
    'PF1': 5, 'PF3': 6, 'WD4': 7, 'WN6': 8, 'WN7': 9
  }).get(code, 0); 
  return f.set('habitat_num', num);
}).filter(ee.Filter.gt('habitat_num', 0));

// 3. SELECT IMAGERY
var image = ee.ImageCollection("COPERNICUS/S2_SR_HARMONIZED")
  .filterBounds(habitatPolygons)
  .filterDate('2019-01-01', '2019-12-31')
  .median()
  .clip(habitatPolygons);

// CRITICAL FIX: Scale to 0-1 range for empirical index formulas
var scaledImage = image.divide(10000.0);

var nir   = scaledImage.select('B8');
var red   = scaledImage.select('B4');
var blue  = scaledImage.select('B2');
var green = scaledImage.select('B3');

// Calculate Indices with properly scaled values
var ndvi  = scaledImage.normalizedDifference(['B8', 'B4']).rename('NDVI');
var rvi   = nir.divide(red).rename('RVI');
var savi  = scaledImage.expression('((NIR - RED) / (NIR + RED + 0.5)) * 1.5', {'NIR': nir, 'RED': red}).rename('SAVI');
var evi   = scaledImage.expression('2.5 * ((NIR - RED) / (NIR + 6 * RED - 7.5 * BLUE + 1))', {'NIR': nir, 'RED': red, 'BLUE': blue}).rename('EVI');
var gndvi = scaledImage.normalizedDifference(['B8', 'B3']).rename('GNDVI');
var grvi  = scaledImage.normalizedDifference(['B3', 'B4']).rename('GRVI');
var nrvi  = (rvi.subtract(1)).divide(rvi.add(1)).rename('NRVI');
var ndwi  = scaledImage.normalizedDifference(['B3', 'B8']).rename('NDWI');

// COMBINE INTO FINAL SUPER-STACK
// Keeps raw bands (0-10000) for the RF classifier, but attaches correct indices
var finalImage = image.select(['B2', 'B3', 'B4', 'B8']) 
   .addBands([ndvi, rvi, savi, evi, gndvi, grvi, nrvi, ndwi]);


// 4. INCREASE PIXELS (Sampling at 5m scale instead of 10m)
var allSamples = finalImage.sampleRegions({
  collection: habitatsMapped,
  properties: ['habitat_num'],
  scale: 5, // Lower scale = more training pixels
  tileScale: 4
}).randomColumn('random');

var trainingSamples = allSamples.filter(ee.Filter.lt('random', 0.80));
var validationSamples = allSamples.filter(ee.Filter.gte('random', 0.20));

// 5. TRAIN ROBUST CLASSIFIER (More trees for complex centers)
var classifier = ee.Classifier.smileRandomForest(250).train({
  features: trainingSamples,
  classProperty: 'habitat_num',
  inputProperties: finalImage.bandNames()
});

// 6. VALIDATE & SMOOTH
var validated = validationSamples.classify(classifier);
var testAccuracy = validated.errorMatrix('habitat_num', 'classification');

print('--- UPDATED RESULTS ---');
print('Total Pixels Found:', allSamples.size());
print('Validation Accuracy:', testAccuracy.accuracy());

var rawClassified = finalImage.classify(classifier);

// Subtle square smoothing to keep bog edges clean
var smoothed = rawClassified
  .reproject({crs: 'EPSG:4326', scale: 10})
  .focalMode(1, 'square', 'pixels');

// 7. DISPLAY & EXPORT
