// 16. McNEMAR TEST (FINAL STABLE VERSION)
// =================================================================

// A. Train a second classifier (CART) to compare against your RF
var classifier2 = ee.Classifier.smileCart().train({
  features: trainingSamples,
  classProperty: 'habitat_num',
  inputProperties: finalImage.bandNames()
});

// B. Apply BOTH classifiers to the same validation collection
// This adds 'RF_pred' and 'CART_pred' to every feature
var comparisons = validationSamples
  .classify(classifier, 'RF_pred')
  .classify(classifier2, 'CART_pred');

// C. Calculate Discordant Pairs (B and C)
var discordantStats = comparisons.map(function(f) {
  var actual = ee.Number(f.get('habitat_num'));
  var p1 = ee.Number(f.get('RF_pred'));
  var p2 = ee.Number(f.get('CART_pred'));
  
  var correct1 = p1.eq(actual);
  var correct2 = p2.eq(actual);
  
  // B: RF is correct AND CART is wrong (1)
  var isB = correct1.and(correct2.not());
  // C: RF is wrong AND CART is correct (1)
  var isC = correct1.not().and(correct2);
  
  return f.set({ 'isB': isB, 'isC': isC });
});

// D. Sum the results
var countB = ee.Number(discordantStats.aggregate_sum('isB'));
var countC = ee.Number(discordantStats.aggregate_sum('isC'));

// E. Calculate Chi-Square (with Yates's Correction)
// Formula: (|B - C| - 1)^2 / (B + C)
var chiSquare = countB.subtract(countC).abs().subtract(1).pow(2)
  .divide(countB.add(countC));

print('--- McNEMAR STATISTICAL TEST ---');
print('B (RF Correct / CART Wrong):', countB);
print('C (RF Wrong / CART Correct):', countC);
print('Chi-Square Statistic:', chiSquare);

// Quick Interpretation
var msg = ee.Algorithms.If(chiSquare.gt(3.84), 
  'RESULT: Statistically Significant (p < 0.05)', 
  'RESULT: Not Statistically Significant');
print(msg);


// 1. Group and dissolve all polygons by habitat code so each class has exactly ONE geometry
var habitatCodesUnique = ['FS1', 'FS2', 'FW2/WL2', 'GS4', 'PF1', 'PF3', 'WD4', 'WN6', 'WN7'];

var dissolvedHabitats = ee.FeatureCollection(
  habitatCodesUnique.map(function(code) {
    var matchingPolygons = habitatsMapped.filter(ee.Filter.eq('HCH_MAPPED', code));
    var unionedGeometry = matchingPolygons.geometry(); // Merges all matching polygons together
    return ee.Feature(unionedGeometry, {'Habitat': code});
  })
);

// 2. Define the 5 core percentiles needed for a box plot structure
var boxPlotReducer = ee.Reducer.percentile([0, 25, 50, 75, 100], ['min', 'p25', 'median', 'p75', 'max']);

// 3. Extract metrics over the dissolved geometries and map into charts
var generateBoxPlot = function(bandName, yAxisLabel, chartTitle, colorCode) {
  var bandImage = finalImage.select(bandName);
  
  var statsCollection = dissolvedHabitats.map(function(feature) {
    var code = feature.get('Habitat');
    
    var stats = bandImage.reduceRegion({
      reducer: boxPlotReducer,
      geometry: feature.geometry(),
      scale: 10,
      maxPixels: 1e13
    });
    
    return ee.Feature(null, {
      'Habitat': code,
      'min': stats.get(bandName + '_min'),
      'p25': stats.get(bandName + '_p25'),
      'median': stats.get(bandName + '_median'),
      'p75': stats.get(bandName + '_p75'),
      'max': stats.get(bandName + '_max')
    });
  }).filter(ee.Filter.notNull(['median']));

  // Create the final chart structure
  var chart = ui.Chart.feature.byFeature({
    features: statsCollection,
    xProperty: 'Habitat',
    yProperties: ['median']
  })
  .setChartType('LineChart')
  .setOptions({
    title: chartTitle,
    vAxis: {title: yAxisLabel},
    hAxis: {title: 'Habitat Class'},
    legend: {position: 'none'},
    lineWidth: 0, 
    pointsVisible: true,
    pointSize: 4,
    colors: [colorCode],
    intervals: {
      'style': 'boxes', 
      'lineWidth': 1, 
      'barWidth': 0.5, 
      'fillOpacity': 0.5
    },
    interval: {
      'min': {'style': 'whiskers', 'attribute': 'min'},
      'p25': {'style': 'boxes', 'attribute': 'p25'},
      'p75': {'style': 'boxes', 'attribute': 'p75'},
      'max': {'style': 'whiskers', 'attribute': 'max'}
    }
  });

  return chart;
};

