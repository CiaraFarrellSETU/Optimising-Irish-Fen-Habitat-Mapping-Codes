// =================================================================
// 1. IMPORT ASSET & PRE-FILTER
// =================================================================
var habitatPolygons = ee.FeatureCollection("projects/ciarafarrell755/assets/Sbog")
  .filter(ee.Filter.notNull(['HCH_MAPPED']));

// =================================================================
// 2. CONVERT STRINGS TO NUMBERS
// =================================================================
var habitatNames = ['FS1', 'FS2', 'FW2/WL2', 'GS4', 'PF1', 'PF3', 'WD4', 'WN6', 'WN7'];
var habitatIDs = [1, 2, 3, 4, 5, 6, 7, 8, 9];

var habitatsMapped = habitatPolygons.map(function(f) {
  var code = ee.String(f.get('HCH_MAPPED'));
  var num = ee.Dictionary({
    'FS1': 1, 'FS2': 2, 'FW2/WL2': 3, 'GS4': 4, 
    'PF1': 5, 'PF3': 6, 'WD4': 7, 'WN6': 8, 'WN7': 9
  }).get(code, 0); 
  return f.set('habitat_num', num);
}).filter(ee.Filter.gt('habitat_num', 0));

// =================================================================
// 3. SELECT IMAGERY WITH CLOUD FILTER (< 30%)
// =================================================================
// var image = ee.ImageCollection("COPERNICUS/S2_SR_HARMONIZED")
//   .filterBounds(habitatPolygons)
//   .filterDate('2020-01-01', '2020-12-31')
//   .filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE', 30)) // NEW: Cloud filter
//   .median()
//   .clip(habitatPolygons);

// var ndvi = image.normalizedDifference(['B8', 'B4']).rename('NDVI');
// //var finalImage = image.addBands(ndvi).select(['B2', 'B3', 'B4', 'B8', 'NDVI']);
// var finalImage = image.addBands(ndvi).select(['B2', 'B3', 'B4', 'B8']);

// =================================================================
// 3. 2024 MEDIAN COMPOSITE + 8 INDICES + AUXILIARY
// =================================================================

// 1. Create the base 2024 Median Composite
 var image = ee.ImageCollection("COPERNICUS/S2_SR_HARMONIZED")
   .filterBounds(habitatPolygons)
   .filterDate('2020-01-01', '2020-12-31')
   .filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE', 30))
   .median()
   .clip(habitatPolygons);

// // Define Base Bands for Calculations
 var nir   = image.select('B8');
 var red   = image.select('B4');
 var blue  = image.select('B2');
 var green = image.select('B3');

// // 2. CALCULATE 8 SPECTRAL INDICES (Vegetation & Water Health)
 var ndvi  = image.normalizedDifference(['B8', 'B4']).rename('NDVI');
 var rvi   = nir.divide(red).rename('RVI');
 var savi  = image.expression('((NIR - RED) / (NIR + RED + 0.5)) * 1.5', {'NIR': nir, 'RED': red}).rename('SAVI');
 var evi   = image.expression('2.5 * ((NIR - RED) / (NIR + 6 * RED - 7.5 * BLUE + 1))', {'NIR': nir, 'RED': red, 'BLUE': blue}).rename('EVI');
 var gndvi = image.normalizedDifference(['B8', 'B3']).rename('GNDVI');
 var grvi  = image.normalizedDifference(['B3', 'B4']).rename('GRVI');
 var nrvi  = (rvi.subtract(1)).divide(rvi.add(1)).rename('NRVI');
 var ndwi  = image.normalizedDifference(['B3', 'B8']).rename('NDWI');

// // 3. FETCH AUXILIARY VARIABLES (Topography from SRTM)
// // This tells the AI if a pixel is in a low-lying wet basin or on a slope
 var topo      = ee.Image("USGS/SRTMGL1_003"); 
 var elevation = topo.select('elevation').clip(habitatPolygons).rename('elevation');
 var terrain   = ee.Terrain.products(elevation);
 var slope     = terrain.select('slope').rename('slope');
 var aspect    = terrain.select('aspect').rename('aspect');

// // 4. COMBINE INTO FINAL TRAINING STACK (15 BANDS TOTAL)
// var finalImage = image.select(['B2', 'B3', 'B4', 'B8']) // 4 Spectral Bands
//   .addBands([ndvi, rvi, savi, evi, gndvi, grvi, nrvi, ndwi]) // 8 Indices
   //.addBands([elevation, slope, aspect]);                    // 3 Aux Variables
   
   // 5. COMBINE INTO FINAL "SUPER-STACK" (8 BANDS TOTAL)
var finalImage = ee.Image([ndvi, rvi, savi, evi, gndvi, grvi, nrvi, ndwi]);


 print('Final Stack Layers for Classifier:', finalImage.bandNames());

// =================================================================
// 4. INCREASE PIXELS (Sampling at m scale)
// =================================================================
var allSamples = finalImage.sampleRegions({
  collection: habitatsMapped,
  properties: ['habitat_num'],
  scale: 5, 
  tileScale: 4
}).randomColumn('random');

var trainingSamples = allSamples.filter(ee.Filter.lt('random', 0.8));
var validationSamples = allSamples.filter(ee.Filter.gte('random', 0.8));

// =================================================================
// 5. TRAIN ROBUST CLASSIFIER
// =================================================================
var classifier = ee.Classifier.smileRandomForest(250).train({
  features: trainingSamples,
  classProperty: 'habitat_num',
  inputProperties: finalImage.bandNames()
});

// =================================================================
// 6. VALIDATE & SMOOTH
// =================================================================
var rawClassified = finalImage.classify(classifier);

// Subtle square smoothing to keep bog edges clean
var smoothed = rawClassified
  .reproject({crs: 'EPSG:4326', scale: 10})
  .focalMode(1, 'square', 'pixels');

// =================================================================
// 7. DISPLAY LAYERS
// =================================================================
Map.centerObject(habitatPolygons, 15);
var bogPalette = ['#FFA500', '#008000', '#FFC0CB', '#FF0000', '#800080', '#A52A2A', '#D2B48C', '#FFFF00', '#0000FF'];

Map.addLayer(finalImage, {bands: ['B4', 'B3', 'B2'], min: 0, max: 3000}, 'Satellite (True Color)');
Map.addLayer(smoothed, {min: 1, max: 9, palette: bogPalette}, 'Scragh Bog Classified Map');

// =================================================================
// 8. ACCURACY REPORTING
// =================================================================
var validated = validationSamples.classify(classifier);
var errorMatrix = validated.errorMatrix('habitat_num', 'classification');

print('--- ACCURACY REPORT ---');
print('Overall Accuracy:', errorMatrix.accuracy());
print('Kappa Coefficient:', errorMatrix.kappa());
print('Producer\'s Accuracy (Precision):', errorMatrix.producersAccuracy());
print('User\'s Accuracy (Recall):', errorMatrix.consumersAccuracy());
var trainAccuracyMatrix = classifier.confusionMatrix();

print('--- TRAINING ACCURACY (Internal) ---');
print('Training Accuracy:', trainAccuracyMatrix.accuracy());
print('Training Confusion Matrix:', trainAccuracyMatrix);
// =================================================================
// 9. DATA INSPECTION (Cloud Check)
// =================================================================
var collectionBeforeMedian = ee.ImageCollection("COPERNICUS/S2_SR_HARMONIZED")
  .filterBounds(habitatPolygons)
  .filterDate('2024-01-01', '2024-12-31')
  .filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE', 30));

print('Number of images used after cloud filter:', collectionBeforeMedian.size());
var dates = collectionBeforeMedian.map(function(img) {
  return ee.Feature(null, {'date': img.date().format('YYYY-MM-dd')});
}).aggregate_array('date');
print('Dates of images used:', dates);

// =================================================================
// 10. AREA CALCULATION (% AND HECTARES)
// =================================================================
var classNames = ee.List(['FS1', 'FS2', 'FW2/WL2', 'GS4', 'PF1', 'PF3', 'WD4', 'WN6', 'WN7']);
var areaImage = ee.Image.pixelArea().addBands(smoothed);

var areas = areaImage.reduceRegion({
  reducer: ee.Reducer.sum().group({
    groupField: 1,
    groupName: 'class',
  }),
  geometry: habitatPolygons.geometry(),
  scale: 10,
  maxPixels: 1e13
});

var stats = ee.List(areas.get('groups'));

var areaResults = stats.map(function(item) {
  var dict = ee.Dictionary(item);
  var classId = ee.Number(dict.get('class')).toInt();
  var areaM2 = ee.Number(dict.get('sum'));
  var areaHa = areaM2.divide(10000);
  var label = classNames.get(classId.subtract(1));
  
  return ee.Feature(null, {
    'Habitat_Code': label,
    'Class_ID': classId,
    'Area_Ha': areaHa,
    'Area_M2': areaM2
  });
});

var areaFC = ee.FeatureCollection(areaResults);
var totalArea = areaFC.aggregate_sum('Area_Ha');

var finalStats = areaFC.map(function(f) {
  var pct = ee.Number(f.get('Area_Ha')).divide(totalArea).multiply(100);
  return f.set('Percentage', pct);
});

// =================================================================
// 11. VISUALIZATION CHARTS
// =================================================================
var barChart = ui.Chart.feature.byFeature({
  features: finalStats,
  xProperty: 'Habitat_Code',
  yProperties: ['Area_Ha']
})
.setChartType('ColumnChart')
.setOptions({
  title: 'Habitat Area Distribution - Hectares',
  vAxis: {title: 'Area (Ha)'},
  hAxis: {title: 'Habitat Type'},
  colors: ['#1d6b99'],
  legend: {position: 'none'}
});

print(barChart);

var pieChart = ui.Chart.feature.byFeature({
  features: finalStats,
  xProperty: 'Habitat_Code',
  yProperties: ['Percentage']
})
.setChartType('PieChart')
.setOptions({
  title: 'Habitat Composition (%)',
  colors: bogPalette,
});

print(pieChart);

print('--- HABITAT PERCENTAGE BREAKDOWN ---');
finalStats.evaluate(function(featureCollection) {
  featureCollection.features.forEach(function(feature) {
    var props = feature.properties;
    print(props.Habitat_Code + ': ' + props.Percentage.toFixed(2) + '% (' + props.Area_Ha.toFixed(2) + ' Ha)');
  });
});
