];

// 1. True Color Layer (using the raw 'image' variable)
Map.addLayer(image, {bands: ['B4', 'B3', 'B2'], min: 0, max: 3000}, 'Satellite (True Color)');

// 2. Classified Layer (using 15 classes)
Map.addLayer(smoothed, {
  min: 1, 
  max: 15, 
