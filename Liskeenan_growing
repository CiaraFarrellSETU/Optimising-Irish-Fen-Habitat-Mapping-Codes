// =================================================================
// 13. CALCULATE ACTUAL & CLASSIFIED AREAS (STRICT PROJECTION)
// =================================================================

// 1. Calculate Vector Actual Areas (from your shapefile)
var actualStatsFC = ee.FeatureCollection(habitatNames.map(function(label) {
  var filtered = habitatsMapped.filter(ee.Filter.eq('HCH_MAPPED', label));
  var areaM2 = filtered.geometry().area();
  var areaHa = ee.Number(areaM2).divide(10000);
  
  return ee.Feature(null, {
    'Habitat_Code': label,
    'Actual_Area_Ha': areaHa
  });
}));

// 2. Calculate Classified Raster Areas 
// We use a specific projection (EPSG:3857) to ensure meters are calculated correctly
var areaImage = ee.Image.pixelArea().divide(10000); 
var classifiedWithArea = areaImage.addBands(smoothed);

var classifiedAreaStats = classifiedWithArea.reduceRegion({
  reducer: ee.Reducer.sum().group({
    groupField: 1,
    groupName: 'habitat_num',
  }),
  geometry: habitatPolygons.geometry(),
  scale: 10, // Matches Sentinel-2 resolution
  maxPixels: 1e8,
  tileScale: 4 // Helps with memory for complex bogs
});

var classifiedCounts = ee.List(classifiedAreaStats.get('groups'));

// Convert the list of results into a lookup dictionary for Section 14
var classDict = ee.Dictionary(classifiedCounts.map(function(item) {
  var d = ee.Dictionary(item);
  return [ee.String(d.get('habitat_num')), d.get('sum')];
}).flatten());

// =================================================================
// 14. ENHANCED COMPARISON GRAPH (FINAL VERSION)
// =================================================================

var comparisonFeatures = actualStatsFC.map(function(f) {
  var label = ee.String(f.get('Habitat_Code'));
  
  // 1. Get the numerical ID for the current label
  var idIdx = ee.List(habitatNames).indexOf(label);
  var idNum = ee.Number(ee.List(habitatIDs).get(idIdx)).toInt();
  
  // 2. Convert ID to String (GEE Dictionaries require String keys)
  var idKey = idNum.format();
  
  // 3. Lookup the classified area, defaulting to 0 if the class wasn't predicted
  var classHa = ee.Number(
    ee.Algorithms.If(classDict.contains(idKey), classDict.get(idKey), 0)
  );
  
  return f.set({
    'Actual_Ha': f.get('Actual_Area_Ha'),
    'Classified_Ha': classHa
  });
}).sort('Actual_Ha', false); 

// Plotting the final Chart
var comparisonChart = ui.Chart.feature.byFeature({
  features: comparisonFeatures,
  xProperty: 'Habitat_Code',
  yProperties: ['Actual_Ha', 'Classified_Ha']
})
.setChartType('BarChart')
.setSeriesNames(['Original Survey (Actual)', 'RF Classification (Model)'])
.setOptions({
  title: 'Habitat Area Comparison: Mapped vs. Classified ',
  hAxis: {
    title: 'Total Area (Hectares)',
    titleTextStyle: {italic: false, bold: true},
    gridlines: {count: 10}
  },
  vAxis: {
    title: 'Fossitt Habitat Code',
    titleTextStyle: {italic: false, bold: true}
  },
  chartArea: {width: '60%', height: '80%'},
  colors: ['#2c3e50', '#27ae60'], // Dark Slate vs Emerald Green
  bar: {groupWidth: '80%'},
  legend: {position: 'top'}
});

print(comparisonChart);

