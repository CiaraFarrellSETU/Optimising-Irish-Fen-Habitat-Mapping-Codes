// Extract importance scores from the trained classifier
var importance = ee.Dictionary(classifier.explain().get('importance'));

// Convert to a FeatureCollection for plotting
var importanceFC = ee.FeatureCollection(
  importance.keys().map(function(key) {
    return ee.Feature(null, {
      'index': key,
      'importance': importance.get(key)
    });
  })
).sort('importance', false); // Sort so the most important index is at the top

// Create the Chart
var importanceChart = ui.Chart.feature.byFeature({
  features: importanceFC,
  xProperty: 'index',
  yProperties: ['importance']
})
.setChartType('ColumnChart')
.setOptions({
  title: 'Random Forest Feature Importance (Spectral Indices)',
  vAxis: {title: 'Importance Score'},
  hAxis: {title: 'Spectral Index'},
  legend: {position: 'none'},
  colors: ['#e67e22'] // Orange color to stand out
});

