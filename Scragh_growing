// =================================================================
// 1. IMPORT ASSET & PRE-FILTER
// =================================================================
var habitatPolygons = ee.FeatureCollection("projects/ciarafarrell755/assets/Sbog")
  .filter(ee.Filter.notNull(['HCH_MAPPED']));

// =================================================================
// 2. CONVERT STRINGS TO NUMBERS
// =================================================================
var habitatNames = ['FS1', 'FS2', 'FW2/WL2', 'GS4', 'PF1', 'PF3', 'WD4', 'WN6', 'WN7'];
var habitatIDs = [1, 2, 3, 4, 5, 6, 7, 8, 9];

var habitatsMapped = habitatPolygons.map(function(f) {
  var code = ee.String(f.get('HCH_MAPPED'));
  var num = ee.Dictionary({
    'FS1': 1, 'FS2': 2, 'FW2/WL2': 3, 'GS4': 4, 
    'PF1': 5, 'PF3': 6, 'WD4': 7, 'WN6': 8, 'WN7': 9
  }).get(code, 0); 
  return f.set('habitat_num', num);
}).filter(ee.Filter.gt('habitat_num', 0));



// 3. SELECT IMAGERY + SPECTRAL BANDS
var collectionBeforeMedian = ee.ImageCollection("COPERNICUS/S2_SR_HARMONIZED")
  .filterBounds(habitatPolygons)
  .filterDate('2020-06-01', '2020-09-30')
  //.filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE', 30));

var image = collectionBeforeMedian.median().clip(habitatPolygons);

// --- SPECTRAL INDICES CALCULATION ---

// 1. NDVI (Normalized Difference Vegetation Index)
var ndvi = image.normalizedDifference(['B8', 'B4']).rename('NDVI');

// 2. RVI (Ratio Vegetation Index): NIR / Red
var rvi = image.select('B8').divide(image.select('B4')).rename('RVI');

// 3. GNDVI (Green NDVI): (NIR - Green) / (NIR + Green)
var gndvi = image.normalizedDifference(['B8', 'B3']).rename('GNDVI');

// 4. SAVI (Soil Adjusted Vegetation Index)
var savi = image.expression(
    '1.5 * ((NIR - RED) / (NIR + RED + 0.5))', {
      'NIR': image.select('B8'),
      'RED': image.select('B4')
    }).rename('SAVI');

// 5. EVI (Enhanced Vegetation Index)
var evi = image.expression(
    '2.5 * ((NIR - RED) / (NIR + 6 * RED - 7.5 * BLUE + 1))', {
      'NIR': image.select('B8'),
      'RED': image.select('B4'),
      'BLUE': image.select('B2')
    }).rename('EVI');

// 6. GRVI (Green-Red Vegetation Index): (Green - Red) / (Green + Red)
var grvi = image.normalizedDifference(['B3', 'B4']).rename('GRVI');

// 7. NRVI (Normalized Ratio Vegetation Index): (RVI - 1) / (RVI + 1)
var nrvi = image.expression(
    '(RVI - 1) / (RVI + 1)', {
      'RVI': rvi
    }).rename('NRVI');

// 8. NDWI (Normalized Difference Water Index): (Green - NIR) / (Green + NIR)
var ndwi = image.normalizedDifference(['B3', 'B8']).rename('NDWI');

// --- COMBINE INTO FINAL IMAGE ---
var finalImage = image.addBands([ndvi, rvi, gndvi, savi, evi, grvi, nrvi, ndwi])
  .select(['B2', 'B3', 'B4', 'B8',
    'NDVI', 'RVI', 'GNDVI', 'SAVI', 'EVI', 'GRVI', 'NRVI', 'NDWI'
  ]);
// =================================================================
// 4. INCREASE PIXELS (Sampling at 5m scale)
// =================================================================
var allSamples = finalImage.sampleRegions({
  collection: habitatsMapped,
  properties: ['habitat_num'],
  scale: 5, 
  tileScale: 4
}).randomColumn('random');

var trainingSamples = allSamples.filter(ee.Filter.lt('random', 0.8));
var validationSamples = allSamples.filter(ee.Filter.gte('random', 0.8));

// =================================================================
// 5. TRAIN ROBUST CLASSIFIER
// =================================================================
var classifier = ee.Classifier.smileRandomForest(250).train({
  features: trainingSamples,
  classProperty: 'habitat_num',
  inputProperties: finalImage.bandNames()
});

// =================================================================
// 6. VALIDATE & SMOOTH
// =================================================================
var rawClassified = finalImage.classify(classifier);

var smoothed = rawClassified
  .reproject({crs: 'EPSG:4326', scale: 10})
  .focalMode(1, 'square', 'pixels');

// =================================================================
// 7. DISPLAY LAYERS
// =================================================================
// =================================================================
// 7. DEFINITIVE HABITAT COLOR PALETTE (9 Unique Classes)
// =================================================================
// Standardized colors mapped to your 9 classes:
// 1: FS1, 2: FS2, 3: FW2/WL2, 4: GS4, 5: PF1, 6: PF3, 7: WD4, 8: WN6, 9: WN7
var bogPalette = [
  '#FFA500', // 1: FS1 - Orange
  '#008000', // 2: FS2 - Green
  '#FFC0CB', // 3: FW2/WL2 - Pink
  '#FF0000', // 4: GS4 - Red
  '#800080', // 5: PF1 - Purple
  '#A52A2A', // 6: PF3 - Brown
  '#D2B48C', // 7: WD4 - Tan
  '#FFFF00', // 8: WN6 - Yellow
  '#0000FF'  // 9: WN7 - Blue
];

// Display Raw Background Imagery & Filtered Raster
Map.centerObject(habitatPolygons, 15);
Map.addLayer(finalImage, {bands: ['B4', 'B3', 'B2'], min: 0, max: 3000}, 'Satellite (True Color)', false); // Set to false so it loads turned off
Map.addLayer(smoothed, {min: 1, max: 9, palette: bogPalette}, 'Scragh Bog Pixels (Smoothed)', false);

// =================================================================
// 8. ACCURACY REPORTING (Validation Data - Unseen)
// =================================================================
var validated = validationSamples.classify(classifier);
var errorMatrix = validated.errorMatrix('habitat_num', 'classification');

print('--- VALIDATION ACCURACY (Test Data) ---');
print('Validation Accuracy:', errorMatrix.accuracy());
print('Validation Kappa:', errorMatrix.kappa());

// =================================================================
// 8.5 TRAINING ACCURACY (Internal Check for Overfitting)
// =================================================================
var trainAccuracyMatrix = classifier.confusionMatrix();

print('--- TRAINING ACCURACY (Internal) ---');
print('Training Accuracy:', trainAccuracyMatrix.accuracy());
print('Training Confusion Matrix:', trainAccuracyMatrix);

// =================================================================
// 9. DATA INSPECTION
// =================================================================
var collectionBeforeMedian = ee.ImageCollection("COPERNICUS/S2_SR_HARMONIZED")
  .filterBounds(habitatPolygons)
  .filterDate('2024-01-01', '2024-12-31')
  .filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE', 30));

print('Number of images used:', collectionBeforeMedian.size());

// =================================================================
// 10. AREA CALCULATION
// =================================================================
var classNames = ee.List(['FS1', 'FS2', 'FW2/WL2', 'GS4', 'PF1', 'PF3', 'WD4', 'WN6', 'WN7']);
var areaImage = ee.Image.pixelArea().addBands(smoothed);

var areas = areaImage.reduceRegion({
  reducer: ee.Reducer.sum().group({
    groupField: 1,
    groupName: 'class',
  }),
  geometry: habitatPolygons.geometry(),
  scale: 10,
  maxPixels: 1e13
});

var stats = ee.List(areas.get('groups'));

var areaResults = stats.map(function(item) {
  var dict = ee.Dictionary(item);
  var classId = ee.Number(dict.get('class')).toInt();
  var areaM2 = ee.Number(dict.get('sum'));
  var areaHa = areaM2.divide(10000);
  var label = classNames.get(classId.subtract(1));
  
  return ee.Feature(null, {
    'Habitat_Code': label,
    'Class_ID': classId,
    'Area_Ha': areaHa
  });
});

var areaFC = ee.FeatureCollection(areaResults);
var totalArea = areaFC.aggregate_sum('Area_Ha');

var finalStats = areaFC.map(function(f) {
  var pct = ee.Number(f.get('Area_Ha')).divide(totalArea).multiply(100);
  return f.set('Percentage', pct);
});

// =================================================================
// 11. VISUALIZATION CHARTS
// =================================================================
print(ui.Chart.feature.byFeature(finalStats, 'Habitat_Code', 'Area_Ha').setChartType('ColumnChart').setOptions({title: 'Area (Ha)'}));
print(ui.Chart.feature.byFeature(finalStats, 'Habitat_Code', 'Percentage').setChartType('PieChart').setOptions({title: 'Composition %', colors: bogPalette}));

print('--- HABITAT PERCENTAGE BREAKDOWN ---');
finalStats.evaluate(function(featureCollection) {
  featureCollection.features.forEach(function(feature) {
    var props = feature.properties;
    print(props.Habitat_Code + ': ' + props.Percentage.toFixed(2) + '% (' + props.Area_Ha.toFixed(2) + ' Ha)');
  });
});

// =================================================================
// 12. FEATURE IMPORTANCE PLOT (CORRECTED)
// =================================================================

// 1. Get variable importance from the trained classifier
var importance = ee.Dictionary(classifier.explain().get('importance'));

// 2. Extract keys and map over them to create Features
var importanceFC = ee.FeatureCollection(
  importance.keys().map(function(key) {
    return ee.Feature(null, {
      'Feature': key,
      'Importance': importance.get(key)
    });
  })
);

// 3. Create and format the chart
var importanceChart = ui.Chart.feature.byFeature({
  features: importanceFC.sort('Importance', false), // Sort highest to lowest
  xProperty: 'Feature',
  yProperties: ['Importance']
}).setChartType('ColumnChart')
  .setOptions({
    title: 'Random Forest Variable Importance',
    vAxis: {title: 'Importance Score'},
    hAxis: {title: 'Spectral Bands & Indices'},
    legend: {position: 'none'},
    colors: ['#228B22'] // A nice "Forest" green
  });

print('--- FEATURE IMPORTANCE ---');
print(importanceChart);

// =================================================================
// 8.1 DETAILED ACCURACY METRICS
// =================================================================

// Extract the numerical values from the error matrix
var overallAccuracy = errorMatrix.accuracy();
var kappaValue = errorMatrix.kappa();
var producersAccuracy = errorMatrix.producersAccuracy(); // Accuracy from perspective of map maker
var usersAccuracy = errorMatrix.consumersAccuracy();   // Accuracy from perspective of map user

print('--- FINAL VALIDATION SUMMARY ---');

// Print formatted Overall Accuracy
overallAccuracy.evaluate(function(val) {
  print('Overall Accuracy: ' + (val * 100).toFixed(2) + '%');
});

// Print formatted Kappa
kappaValue.evaluate(function(val) {
  print('Kappa Coefficient: ' + val.toFixed(4));
});

// Optional: Print a table of Producer/User accuracy per class
print('Producers Accuracy (per class):', producersAccuracy);
print('Users Accuracy (per class):', usersAccuracy);


// This calculates the most frequent (mode) class for each polygon
var polygonMajority = rawClassified.reduceRegions({
  collection: habitatPolygons,
  reducer: ee.Reducer.mode(),
  scale: 10
});

// Convert the reduced features back into a vector-snapped clean image
var cleanHabitatMap = polygonMajority
  .filter(ee.Filter.notNull(['mode']))
  .reduceToImage(['mode'], ee.Reducer.first())
