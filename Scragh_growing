// --- VISUALIZE ULTRA CLEAN VECTOR MAP ---
// Setting min: 1 and max: 9 locks each ID perfectly to its assigned palette color index
Map.addLayer(cleanHabitatMap, {min: 1, max: 9, palette: bogPalette}, 'Polygon Majority (Ultra Clean)');

// Optional: Add a subtle black outline of your original vectors over the map for a crisp finish
