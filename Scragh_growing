  return feature.set('Calculated_Ha', area);
});

print('Calculated Area from Geometry:', wn7_with_area.aggregate_sum('Calculated_Ha'));


// =================================================================
// 13. CALCULATE ACTUAL (ORIGINAL ASSET) AREAS FOR COMPARISON
// =================================================================

// We calculate area directly from the geometry of the shapefile (habitatsMapped)
// This avoids errors caused by '0' values in the attribute table or raster scale issues.
var actualStatsFC = ee.FeatureCollection(habitatNames.map(function(label) {
  // Filter the original shapefile for this specific habitat code
  var filtered = habitatsMapped.filter(ee.Filter.eq('HCH_MAPPED', label));
  
  // Calculate area in m2 from geometry, then convert to Hectares
  var areaM2 = filtered.geometry().area();
  var areaHa = ee.Number(areaM2).divide(10000);
  
  return ee.Feature(null, {
    'Habitat_Code': label,
    'Actual_Area_Ha': areaHa
  });
}));

// Debug check: Print this to the console to verify WN7 is now ~5.4
print('Verified Vector Areas:', actualStatsFC);


// =================================================================
// 14. ENHANCED COMPARISON GRAPH (Horizontal Diverging)
// =================================================================

// Prepare the data for the chart by merging Actual and Classified stats
var comparisonFeatures = finalStats.map(function(f) {
  var code = f.get('Habitat_Code');
  
  // Find the corresponding actual area from our new actualStatsFC
  var actualMatch = actualStatsFC.filter(ee.Filter.eq('Habitat_Code', code)).first();
  
  // Safety check: if no match, set area to 0
  var actualHa = ee.Algorithms.If(actualMatch, 
                                 ee.Feature(actualMatch).get('Actual_Area_Ha'), 
                                 0);
  
  return f.set({
    'Classified_Ha': f.get('Area_Ha'),
    'Actual_Ha': actualHa
  });
}).sort('Actual_Ha', false); // Sort by largest actual habitat for better visualization

// Create the Horizontal Bar Chart
var betterChart = ui.Chart.feature.byFeature({
  features: comparisonFeatures,
  xProperty: 'Habitat_Code',
  yProperties: ['Actual_Ha', 'Classified_Ha']
})
.setChartType('BarChart')
.setSeriesNames(['Actual (Mapped Geometry)', 'Classified (Model Output)'])
.setOptions({
  title: 'Habitat Area Comparison: Mapped vs. Classified',
  hAxis: {
    title: 'Total Area (Hectares)',
    titleTextStyle: {italic: false, bold: true},
    gridlines: {count: 10}
  },
  vAxis: {
    title: 'Habitat Code',
    titleTextStyle: {italic: false, bold: true}
  },
  chartArea: {width: '60%', height: '80%'},
  colors: ['#2c3e50', '#27ae60'], // Dark Navy for Reality, Emerald for Model
  bar: {groupWidth: '80%'},
  legend: {position: 'top'}
});

print(betterChart);

// 1. Group and dissolve all polygons by habitat code so each class has exactly ONE geometry
var habitatCodesUnique = ['FS1', 'FS2', 'FW2/WL2', 'GS4', 'PF1', 'PF3', 'WD4', 'WN6', 'WN7'];

var dissolvedHabitats = ee.FeatureCollection(
  habitatCodesUnique.map(function(code) {
    var matchingPolygons = habitatsMapped.filter(ee.Filter.eq('HCH_MAPPED', code));
    var unionedGeometry = matchingPolygons.geometry(); // Merges all matching polygons together
    return ee.Feature(unionedGeometry, {'Habitat': code});
  })
);

// 2. Define the 5 core percentiles needed for a box plot structure
var boxPlotReducer = ee.Reducer.percentile([0, 25, 50, 75, 100], ['min', 'p25', 'median', 'p75', 'max']);

// 3. Extract metrics over the dissolved geometries and map into charts
var generateBoxPlot = function(bandName, yAxisLabel, chartTitle, colorCode) {
  var bandImage = finalImage.select(bandName);
  
  // === FIX HERE: Clamp EVI values so they stay within the standard -1 to 1 range ===
  if (bandName === 'EVI') {
    bandImage = bandImage.clamp(-1.0, 1.0);
  }
  // =================================================================================
  
  var statsCollection = dissolvedHabitats.map(function(feature) {
    var code = feature.get('Habitat');
    
    var stats = bandImage.reduceRegion({
      reducer: boxPlotReducer,
      geometry: feature.geometry(),
      scale: 10,
      maxPixels: 1e13
    });
    
    // Order required by Google Charts: Median, Min, p25, p75, Max
    return ee.Feature(null, {
      'Habitat': code,
      'median': stats.get(bandName + '_median'),
      'min': stats.get(bandName + '_min'),
      'p25': stats.get(bandName + '_p25'),
      'p75': stats.get(bandName + '_p75'),
      'max': stats.get(bandName + '_max')
    });
  }).filter(ee.Filter.notNull(['median']));

  // Create a placeholder UI widget panel that updates once server data arrives
  var chartPanel = ui.Panel({style: {width: '100%', height: '350px'}});
  chartPanel.add(ui.Label('Calculating statistics and rendering box plot...'));

  // Use evaluate to safely pull data to the client side and build a proper DataTable
  statsCollection.evaluate(function(success, failure) {
    if (failure) {
      chartPanel.clear();
      chartPanel.add(ui.Label('Error calculating stats: ' + failure));
      return;
    }
    
    // Define the strict Google Visualization columns with explicit interval roles
    var columns = [
      {id: 'Habitat', label: 'Habitat Class', type: 'string'},
      {id: 'median', label: 'Median', type: 'number'},
      {id: 'min', type: 'number', role: 'interval'},
      {id: 'p25', type: 'number', role: 'interval'},
      {id: 'p75', type: 'number', role: 'interval'},
      {id: 'max', type: 'number', role: 'interval'}
    ];
    
    // Map our features directly into rows matching the column structure
    var rows = success.features.map(function(f) {
      var p = f.properties;
      return [p.Habitat, p.median, p.min, p.p25, p.p75, p.max];
    });
    
    // Combine into a valid DataTable dictionary object
    var dataTable = {cols: columns, rows: rows.map(function(r) { 
      return {c: r.map(function(v) { return {v: v}; })}; 
    })};
    
    // Build the native UI Chart using the raw data table object
    var cleanChart = ui.Chart(dataTable, 'LineChart', {
      title: chartTitle,
      vAxis: {title: yAxisLabel},
      hAxis: {title: 'Habitat Class'},
      legend: {position: 'none'},
      
      lineWidth: 0, // No horizontal connecting trend lines!
      pointsVisible: true,
      pointSize: 6,
      colors: [colorCode],
      
      // Style the structural intervals natively
      intervals: { 'style': 'boxes', 'color': colorCode, 'fillOpacity': 0.4 },
      interval: {
        'min': { 'style': 'whiskers', 'lineWidth': 1.5 },
        'max': { 'style': 'whiskers', 'lineWidth': 1.5 },
        'p25': { 'style': 'boxes' },
        'p75': { 'style': 'boxes' }
      }
    });
    
    // Swap the loading label out for our beautiful new chart
    chartPanel.clear();
    chartPanel.add(cleanChart);
  });

  return chartPanel;
};

// 4. Print the correct aggregated box plots to your console panel

print('--- AGGREGATED HABITAT SPECTRAL BOX PLOTS ---');

print(generateBoxPlot('EVI', 'Index Value (-1 to 1)', 'EVI Distribution per Habitat Class', '#1b9e77'));

print(generateBoxPlot('B2', 'Reflectance (0 to 10000)', 'B2 Blue Band Distribution per Habitat Class', '#d95f02'));

// =================================================================
// 8. ACCURACY REPORTING (Validation Data - Unseen)
// =================================================================
var classIds = [1, 2, 3, 4, 5, 6, 7, 8, 9];

// Explicitly pass the expected class order to guarantee alignment
var validated = validationSamples.classify(classifier);
var errorMatrix = validated.errorMatrix('habitat_num', 'classification', classIds);

print('--- VALIDATION ACCURACY (Test Data) ---');
print('Validation Accuracy:', errorMatrix.accuracy());
print('Validation Kappa:', errorMatrix.kappa());


// =================================================================
// 8.1 DETAILED PER-CLASS METRICS & NICE CONFUSION MATRIX TABLE
// =================================================================
print('--- FINAL VALIDATION SUMMARY ---');
errorMatrix.accuracy().evaluate(function(val) {
  print('Overall Accuracy: ' + (val * 100).toFixed(2) + '%');
});

errorMatrix.kappa().evaluate(function(val) {
  print('Kappa Coefficient: ' + val.toFixed(4));
});

var cmArray = ee.Array(errorMatrix.array());

print('--- PER-CLASS METRICS BREAKDOWN ---');
cmArray.evaluate(function(matrix) {
  habitatNames.forEach(function(name, i) {
    var rowSum = 0; 
    var colSum = 0; 
    var correct = matrix[i][i]; 

    for (var j = 0; j < habitatNames.length; j++) {
      rowSum += matrix[i][j];
      colSum += matrix[j][i];
    }

    var pa = (rowSum > 0) ? ((correct / rowSum) * 100).toFixed(2) : 'N/A';
    var ua = (colSum > 0) ? ((correct / colSum) * 100).toFixed(2) : 'N/A';

    print(name + ' -> Producer\'s Accuracy: ' + pa + '% | User\'s Accuracy: ' + ua + '%');
  });
});

// =================================================================
// 8.1 FORMATTED CONFUSION MATRIX TABLE DISPLAY
// =================================================================
print('--- CONFUSION MATRIX TABLE (Actual Rows vs Predicted Columns) ---');

cmArray.evaluate(function(matrix) {
  // Print header row with habitat names
  var header = 'Actual \\ Pred\t' + habitatNames.join('\t');
  print(header);
  
  // Print each row with its corresponding habitat label
  matrix.forEach(function(row, i) {
    var rowString = habitatNames[i] + '\t\t' + row.join('\t');
    print(rowString);
  });
});
