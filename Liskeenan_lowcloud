print('Number of images used after cloud filter:', collectionBeforeMedian.size());
var dates = collectionBeforeMedian.map(function(img) {
  return ee.Feature(null, {'date': img.date().format('YYYY-MM-dd')});
}).aggregate_array('date');
print('Dates of images used:', dates);
// --- DETAILED ACCURACY REPORT ---
print('--- VALIDATION METRICS ---');
print('Confusion Matrix (Validation):', errorMatrix);
print('Overall Accuracy (Validation):', errorMatrix.accuracy());
print('Kappa Coefficient (Validation):', errorMatrix.kappa());
 
